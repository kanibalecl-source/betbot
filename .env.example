# Skopiuj jako .env i wpisz klucze, jeśli nie trzymasz ich w data_api.py albo secrets_config.py
API_FOOTBALL_KEY=
ODDS_API_KEY=

# Production security (minimum 32 random characters for API_KEY).
ENVIRONMENT=local
API_KEY=
DATABASE_URL=
POSTGRES_DSN=
API_SYNC_ENABLED=0
API_MAX_PAGE_SIZE=100
BETTING_ENABLED=false
BETBOT_ADMIN_USERNAME=
# Generate with: python setup_secure_admin.py
BETBOT_ADMIN_PASSWORD_HASH=

# Persistent Railway Volume. Production startup is blocked without it.
PERSISTENT_DATA_DIR=/data
KANIBAL_REQUIRE_PERSISTENT_STORAGE=1
BETBOT_SERVER_BACKUP_REUSE_HOURS=0
BETBOT_SERVER_BACKUP_KEEP=5
BETBOT_SERVER_BACKUP_EMERGENCY_REUSE_HOURS=24

# Separate FastAPI service. Keep reads disabled until parity checks pass.
BETBOT_FASTAPI_URL=https://betbot-api-production.up.railway.app
BETBOT_FASTAPI_API_KEY=
BETBOT_FASTAPI_SYNC_ENABLED=0
BETBOT_FASTAPI_SYNC_MINUTES=30
BETBOT_FASTAPI_READ_ENABLED=0
BETBOT_MAX_ODDS_AGE_SECONDS=300
API_FOOTBALL_ODDS_CACHE_SECONDS=240
API_FOOTBALL_ODDS_MIN_INTERVAL_SECONDS=2.5
API_FOOTBALL_RATE_LIMIT_COOLDOWN_SECONDS=65
BETBOT_STRATEGY_VERSION=strict-v1

# Quality diagnostics and evidence-based abstention. The gate stays fail-open
# until the derived policy has enough settled samples and passes integrity.
BETBOT_QUALITY_SELECTION_GATE_ENFORCE=true
BETBOT_QUALITY_DIAGNOSTIC_MIN_SEGMENT_SAMPLES=50
BETBOT_QUALITY_BASE_MIN_EDGE=0.02
BETBOT_MAX_DAILY_RECOMMENDATIONS=12
BETBOT_CLOSING_ODDS_WINDOW_MINUTES=45
BETBOT_GUARDIAN_MIN_LEDGER_COVERAGE=0.99
BETBOT_GUARDIAN_MIN_SETTLEMENT_COVERAGE=0.95
BETBOT_GUARDIAN_MAX_API_ERRORS_24H=5
BETBOT_FEATURE_IMPACT_MIN_SAMPLES=100
BETBOT_QUALITY_MIN_CLOSING_COVERAGE=0.80
BETBOT_QUALITY_MIN_CLV_SAMPLES=100
BETBOT_QUALITY_QUARANTINE_WINDOW=100
BETBOT_MODEL_VERSION=champion-current
BETBOT_QUALITY_SEGMENT_MIN_SAMPLES=500
BETBOT_QUALITY_MAX_SEGMENTS=12
BETBOT_QUALITY_CANDIDATE_WINDOWS=1.0,0.75,0.50
BETBOT_QUALITY_WF_MIN_TEST_SAMPLES=300
BETBOT_QUALITY_WF_MIN_FOLDS=4
BETBOT_LIVE_SHADOW_MIN_SAMPLES=300
BETBOT_AUTONOMY_MIN_SETTLED_FOR_TRAINING=300
BETBOT_AI_LEARNING_MIN_SEGMENT_SAMPLES=50
BETBOT_AI_LEARNING_PRIOR_STRENGTH=100

# Autonomous Learning Governor v7. Promotion remains disabled until explicitly
# enabled; even then Guardian + walk-forward + live shadow + canary must pass.
BETBOT_AUTONOMOUS_GOVERNOR_ENABLED=1
BETBOT_AUTONOMOUS_PROMOTION_ENABLED=1
BETBOT_AUTONOMOUS_ROLLBACK_ENABLED=1
BETBOT_GOVERNOR_ROLLBACK_FAILURES=3
BETBOT_GOVERNOR_CHECK_MINUTES=60
BETBOT_GOVERNOR_CANARY_25_NEW_SAMPLES=50
BETBOT_GOVERNOR_CANARY_50_NEW_SAMPLES=120
BETBOT_GOVERNOR_CANARY_100_NEW_SAMPLES=250

# Statistical Evidence Scorecard v8. Every core gate must pass before the
# system may label the edge statistically confirmed.
BETBOT_EVIDENCE_MIN_OOS_SAMPLES=1000
BETBOT_EVIDENCE_MIN_CLV_SAMPLES=200
BETBOT_EVIDENCE_MIN_SEGMENT_SAMPLES=250
BETBOT_EVIDENCE_MAX_ECE=0.05

# Staged Capital Governor v8. Real capital remains separately and explicitly
# disabled. The governor never changes BETTING_ENABLED itself.
BETBOT_CAPITAL_REAL_ENABLED=0
BETBOT_CAPITAL_POLICY_MAX_AGE_SECONDS=7200
BETBOT_CAPITAL_RUNTIME_MAX_AGE_SECONDS=7200

# Architecture Hardening v8.1
BETBOT_HEARTBEAT_SECONDS=30
# Retraining has exactly one owner: quality_governance_v8.
# Do not start auto_retraining_loop.py as a separate Railway process.

# Volleyball autonomous shadow collection.
# 150,000 API requests/day leaves a large safety reserve at this interval.
BETBOT_VOLLEYBALL_POLL_MINUTES=30

# Handball autonomous shadow collection.
# Uses a separate API-Sports key and a completely isolated database.
BETBOT_HANDBALL_ENABLED=0
BETBOT_HANDBALL_SHADOW_ONLY=1
HANDBALL_API_SPORTS_KEY=your_api_sports_handball_key_here
HANDBALL_API_SPORTS_BASE_URL=https://v1.handball.api-sports.io
BETBOT_HANDBALL_TIMEZONE=Europe/Warsaw
BETBOT_HANDBALL_POLL_MINUTES=30
BETBOT_HANDBALL_BACKFILL_DAYS=30
BETBOT_HANDBALL_MIN_EDGE=0.03
BETBOT_HANDBALL_MIN_BOOKMAKERS=2

# Football odds shown as "Buk" are accepted only from this allowlist.
# Use provider bookmaker names; "*" is intended only for isolated tests.
BETBOT_FOOTBALL_BOOKMAKER_ALLOWLIST=superbet,sts,fortuna,betclic,etoto,forbet,totalbet,pzbuk
# Sources used only to verify independent market consensus. The published
# "Buk" price still comes exclusively from the Polish allowlist above.
BETBOT_FOOTBALL_CONSENSUS_BOOKMAKER_ALLOWLIST=*

# Market Data Integrity v13. Missing/incomplete/stale/outlying markets are
# quarantined and cannot be published, trained on or promote a model.
BETBOT_V13_FOOTBALL_MIN_BOOKMAKERS=2
BETBOT_V13_VOLLEYBALL_MIN_BOOKMAKERS=2
BETBOT_V13_HANDBALL_MIN_BOOKMAKERS=2
BETBOT_V13_FOOTBALL_MAX_QUOTE_SKEW_SECONDS=180
BETBOT_V13_VOLLEYBALL_MAX_QUOTE_SKEW_SECONDS=180
BETBOT_V13_HANDBALL_MAX_QUOTE_SKEW_SECONDS=180
BETBOT_V13_FOOTBALL_MAX_PROBABILITY_DISPERSION=0.075
BETBOT_V13_VOLLEYBALL_MAX_PROBABILITY_DISPERSION=0.075
BETBOT_V13_HANDBALL_MAX_PROBABILITY_DISPERSION=0.075
BETBOT_V13_FOOTBALL_MIN_TRAINING_OBSERVATIONS=300
BETBOT_V13_VOLLEYBALL_MIN_TRAINING_OBSERVATIONS=250
BETBOT_V13_HANDBALL_MIN_TRAINING_OBSERVATIONS=300
BETBOT_V13_AUDIT_MAX_AGE_SECONDS=10800
BETBOT_HANDBALL_ODDS_REFRESH_HOURS=12
BETBOT_HANDBALL_EMPTY_ODDS_RETRY_HOURS=6
BETBOT_HANDBALL_LOOKAHEAD_DAYS=7
BETBOT_HANDBALL_MAX_ODDS_REQUESTS_PER_CYCLE=80
BETBOT_HANDBALL_TRAIN_MIN_GAMES=100
BETBOT_HANDBALL_TRAIN_MIN_NEW_GAMES=25
BETBOT_HANDBALL_VALIDATION_MIN_TRAIN_GAMES=40
BETBOT_HANDBALL_VALIDATION_MIN_TEST_GAMES=20
BETBOT_HANDBALL_VALIDATION_MIN_FOLDS=3
BETBOT_HANDBALL_VALIDATION_MAX_FOLDS=5
BETBOT_HANDBALL_AUTONOMOUS_GOVERNOR_ENABLED=1
BETBOT_HANDBALL_LIVE_MIN_SAMPLES=30
BETBOT_HANDBALL_LIVE_REPORT_STEP=10
BETBOT_HANDBALL_LIVE_POSITIVE_REPORTS=3
BETBOT_HANDBALL_LIVE_ROLLBACK_REPORTS=3
BETBOT_HANDBALL_DRIFT_PSI_LIMIT=0.25

# Sportradar multi-sport adapters.
# The provider key is read only from the server environment and is never
# written to health reports, logs, databases or deployment packages.
SPORTRADAR_API_KEY=
BETBOT_SPORTRADAR_SHADOW_ENABLED=0
BETBOT_SPORTRADAR_SHADOW_ONLY=1
BETBOT_SPORTRADAR_ACCESS_LEVEL=trial
BETBOT_SPORTRADAR_LANGUAGE=en
BETBOT_SPORTRADAR_POLL_MINUTES=30
BETBOT_SPORTRADAR_LOOKBACK_DAYS=1
BETBOT_SPORTRADAR_LOOKAHEAD_DAYS=1
BETBOT_SPORTRADAR_TIMEOUT_SECONDS=20
BETBOT_SPORTRADAR_REQUEST_INTERVAL_SECONDS=1.1
BETBOT_SPORTRADAR_MAX_RETRIES=2
BETBOT_SPORTRADAR_ODDS_ENABLED=1
BETBOT_SPORTRADAR_ODDS_MAX_EVENTS_PER_CYCLE=6
# Keep legacy_rowt1 for the currently licensed key. Switch to prematch_v2
# only after Odds Comparison Prematch v2 is enabled for that key.
BETBOT_SPORTRADAR_ODDS_API_VARIANT=legacy_rowt1

# Co ile minut bot ma pobierać typy
BOT_LOOP_MINUTES=120

# Co ile minut system ma sprawdzać wyniki
SETTLE_LOOP_MINUTES=180

# Port panelu WWW
WEB_PORT=8000
# OpenAI GPT-web match analyzer
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MATCH_MODEL=gpt-4.1-mini
GPT_ANALYSIS_MODEL=gpt-5.6-terra
GPT_ANALYSIS_FALLBACK_MODEL=gpt-4.1-mini
GPT_ANALYSIS_CACHE_TTL_SECONDS=1800
GPT_ANALYSIS_TIMEOUT_SECONDS=120
GPT_MAX_MATCHES=20
GPT_MATCH_SLEEP_SECONDS=0.3
BETBOT_FOOTBALL_COUNCIL_MIN_MODELS=4
BETBOT_FOOTBALL_COUNCIL_MAX_DISAGREEMENT=0.12
BETBOT_COUNCIL_MIN_TRAINING_ROWS=500
BETBOT_COUNCIL_MIN_BRIER_GAIN=0.0002
BETBOT_COUNCIL_MIN_LOGLOSS_GAIN=0.0002
BETBOT_COUNCIL_CATBOOST_ITERATIONS=350
BETBOT_COUNCIL_CATBOOST_DEPTH=6
BETBOT_COUNCIL_CATBOOST_LEARNING_RATE=0.035
BETBOT_COUNCIL_CATBOOST_THREADS=2
# Tennis v1 — disabled by default, isolated shadow-only module
BETBOT_TENNIS_ENABLED=0
BETBOT_TENNIS_SHADOW_ONLY=1
BETBOT_TENNIS_POLL_MINUTES=240
BETBOT_TENNIS_BACKFILL_DAYS=30
BETBOT_TENNIS_LOOKAHEAD_DAYS=3
BETBOT_TENNIS_AUTONOMOUS_GOVERNOR_ENABLED=1
BETBOT_TENNIS_INCLUDE_ATP=1
BETBOT_TENNIS_INCLUDE_WTA=1
BETBOT_TENNIS_INCLUDE_CHALLENGER=0
BETBOT_TENNIS_INCLUDE_ITF=0
BETBOT_TENNIS_INCLUDE_DOUBLES=0
BETBOT_TENNIS_MIN_BOOKMAKERS=2
BETBOT_TENNIS_MIN_EDGE=0.03
BETBOT_TENNIS_TRAIN_MIN_MATCHES=1500
BETBOT_TENNIS_TRAIN_MIN_SURFACE_MATCHES=300
BETBOT_TENNIS_TRAIN_MIN_NEW_MATCHES=100
BETBOT_TENNIS_VALIDATION_TEST_MATCHES=200
BETBOT_TENNIS_VALIDATION_MIN_FOLDS=4
BETBOT_TENNIS_MIN_BRIER_IMPROVEMENT=0.002
THE_ODDS_API_KEY=
